# PostgreSQL Database Configuration

# For Production (Render/Neon PostgreSQL) - Use this for deployment
DATABASE_URL=postgresql://neondb_owner:npg_3cxDEzQS0ZpF@ep-small-sound-apnl5p6j.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# For Local Development - Use these individual variables (ignored if DATABASE_URL is set)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=taskdb
DB_PORT=5432

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:3005

# JWT Secret (Change this in production!)
JWT_SECRET=your-secret-key-change-this-in-production

# Email Configuration (for Forgot Password Feature)
# Get Gmail App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Optional alternate names if you prefer Gmail env vars:
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=your-app-password

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
